# J.A.R.V.I.S. 3.0 — variáveis de ambiente. Copie para .env e preencha.
# NUNCA versione o .env. Nenhuma variável aqui é da Anthropic.

# Endereço público (com HTTPS em produção)
PUBLIC_URL=https://jarvis.seudominio.com.br
DOMINIO=jarvis.seudominio.com.br
EMAIL_CERTIFICADO=voce@exemplo.com

# Banco e fila (o docker-compose já sobe os dois)
POSTGRES_PASSWORD=troque-por-uma-senha-longa
DATABASE_URL=postgres://jarvis:troque-por-uma-senha-longa@postgres:5432/jarvis
REDIS_URL=redis://redis:6379

# Chave mestra (cifra segredos no banco): openssl rand -base64 32
JARVIS_MASTER_KEY=
JARVIS_TZ=America/Sao_Paulo
JARVIS_EXIGIR_MFA=1

# Modelos de IA abertos — escolha UM jeito:
# (a) arquivo com vários provedores/níveis e fallback:
JARVIS_MODELOS=/app/modelos.json
# (b) um provedor só, compatível com a API da OpenAI:
# LLM_BASE_URL=https://seu-provedor/v1
# LLM_API_KEY=
# LLM_MODELO_PRINCIPAL=
# LLM_MODELO_RAPIDO=
# LLM_MODELO_EMBEDDINGS=
LLM_ORCAMENTO_DIARIO_USD=1
LLM_SERVERLESS_KEY=
VLLM_API_KEY=

# Busca na internet (SearXNG já vem no compose; sem chave)
SEARXNG_URL=http://searxng:8080
SEARXNG_SECRET=troque-por-um-valor-aleatorio

# Notificações push: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTATO=mailto:voce@exemplo.com

# Integrações opcionais
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_TOKEN=
