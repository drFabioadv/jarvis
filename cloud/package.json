{
  "name": "jarvis-cloud",
  "private": true,
  "version": "3.0.0",
  "description": "J.A.R.V.I.S. 3.0 — plataforma pessoal na nuvem, independente de fornecedor de IA (modelos abertos via API compatível com OpenAI).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "api": "node src/server.mjs",
    "worker": "node src/worker.mjs",
    "migrate": "node src/cli/migrate.mjs up",
    "migrate:down": "node src/cli/migrate.mjs down",
    "owner:setup-token": "node src/cli/setup-token.mjs",
    "test": "node --test --test-concurrency=1 --test-timeout=180000 test/*.test.mjs",
    "lint": "cd .. && oxlint cloud/src cloud/test agente-local"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^10.1.10",
    "@fastify/websocket": "^11.3.7",
    "@simplewebauthn/server": "^14.1.0",
    "bullmq": "^6.7.2",
    "fastify": "^5.12.8",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "ws": "^8.22.2"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "3.8.1"
  }
}