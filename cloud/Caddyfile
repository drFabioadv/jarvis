# HTTPS automático (Let's Encrypt) para o JARVIS. Só isto fica na internet.
{
	email {$EMAIL_CERTIFICADO}
}

{$DOMINIO} {
	encode zstd gzip
	# Sem cache de proxy para a API e o streaming (SSE).
	@api path /api/*
	reverse_proxy @api api:8080 {
		flush_interval -1
		transport http {
			read_timeout 10m
		}
	}
	reverse_proxy api:8080
	header {
		-Server
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
	}
	log {
		output stdout
		format json
	}
}
